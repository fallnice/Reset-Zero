# Unity 文本文件：统一换行符为 LF，避免 CRLF/LF 造成的假 diff
*.cs         text eol=lf
*.meta       text eol=lf
*.unity      text eol=lf
*.prefab     text eol=lf
*.asset      text eol=lf
*.mat        text eol=lf
*.anim       text eol=lf
*.controller text eol=lf
*.inputactions text eol=lf
*.tss        text eol=lf
*.shader     text eol=lf
*.cginc      text eol=lf
*.json       text eol=lf
*.xml        text eol=lf
*.txt        text eol=lf
*.md         text eol=lf
*.rsp        text eol=lf

# 二进制资源：不做文本转换
*.fbx    binary
*.png    binary
*.jpg    binary
*.jpeg   binary
*.tga    binary
*.psd    binary
*.dll    binary
*.db     binary
*.bytes  binary
